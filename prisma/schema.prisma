generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id        Int       @id @default(autoincrement())
  title     String?   @db.VarChar(10)
  subtitle  String?
  tag       String?   @db.VarChar(5)
  content   String?
  createdAt DateTime? @db.Time(6)
  updatedAt DateTime? @updatedAt @db.Time(6)
}
