generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  username     String   @unique @db.VarChar(15)
  bids         Bid[]
  Post         Post[]   @relation("Buyer")
  posts        Post[]
}

model Post {
  id                   Int               @id @default(autoincrement())
  title                String?           @db.VarChar(50)
  category             categories?
  description          String?
  createdAt            DateTime?         @default(now())
  updatedAt            DateTime?
  userId               Int?
  buyNowPrice          Float?
  currentPrice         Float?
  isSold               Boolean           @default(false)
  startingPrice        Float
  buyerId              Int?
  endsAt               DateTime?
  increment            increments?
  transactionStatus    TransactionStatus @default(PENDING)
  transactionUpdatedAt DateTime?
  bids                 Bid[]
  images               Image[]
  buyer                User?             @relation("Buyer", fields: [buyerId], references: [id])
  User                 User?             @relation(fields: [userId], references: [id])
}

model Bid {
  id        Int      @id @default(autoincrement())
  amount    Float
  userId    Int
  postId    Int
  createdAt DateTime @default(now())
  Post      Post     @relation(fields: [postId], references: [id])
  User      User     @relation(fields: [userId], references: [id])
}

model Image {
  id        Int      @id @default(autoincrement())
  path      String
  postId    Int
  createdAt DateTime @default(now())
  Post      Post     @relation(fields: [postId], references: [id])
}

enum categories {
  Elektronik
  Fahrzeuge
  Haushalt
  Kleider_Accessoires @map("Kleider/Accessoires")
  M_bel               @map("Möbel")
  Deko
  Sport
  Sonstiges
}

enum increments {
  ONE         @map("1")
  FIVE        @map("5")
  TEN         @map("10")
  HUNDRED     @map("100")
  FIVEHUNDRED @map("500")
  FIFTY       @map("50")
  THOUSAND    @map("1000")
}

enum TransactionStatus {
  PENDING
  PAYMENT_CONFIRMED_BY_BUYER
  PAYMENT_RECEIVED_AND_SHIPPED
  RECEIVED_CONFIRMED
}
