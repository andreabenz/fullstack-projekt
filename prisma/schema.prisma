generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id          Int         @id @default(autoincrement())
  title       String?     @db.VarChar(10)
  category    categories?
  description String?
  createdAt   DateTime?   @db.Time(6)
  updatedAt   DateTime?   @updatedAt @db.Time(6)
}

enum categories {
  Elektronik
  Fahrzeuge
  Haushalt
  Kleider_Accessoires @map("Kleider/Accessoires")
  M_bel               @map("Möbel")
  Deko
  Sport
  Sonstiges
}
