generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  posts        Post[]
}

model Post {
  id          Int         @id @default(autoincrement())
  title       String?     @db.VarChar(10)
  category    categories?
  description String?
  createdAt   DateTime?   @default(now())
  updatedAt   DateTime?   @updatedAt
  images      Image[]
  User        User?       @relation(fields: [userId], references: [id])
  userId      Int?
}

model Image {
  id        Int      @id @default(autoincrement())
  path      String
  post      Post     @relation(fields: [postId], references: [id])
  postId    Int
  createdAt DateTime @default(now())
}

enum categories {
  Elektronik
  Fahrzeuge
  Haushalt
  Kleider_Accessoires @map("Kleider/Accessoires")
  M_bel               @map("Möbel")
  Deko
  Sport
  Sonstiges
}
