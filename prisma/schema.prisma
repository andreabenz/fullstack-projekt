generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String?  @unique @db.VarChar(15)
  passwordHash String
  createdAt    DateTime @default(now())
  posts        Post[]
  bids         Bid[]

  Post Post[] @relation("Buyer")
}

model Post {
  id          Int         @id @default(autoincrement())
  title       String?     @db.VarChar(10)
  category    categories?
  description String?
  createdAt   DateTime?   @default(now())
  updatedAt   DateTime?   @updatedAt
  userId      Int?
  images      Image[]

  startingPrice Float     @default(10.00)
  buyNowPrice   Float?
  currentPrice  Float?
  endsAt        DateTime?
  buyerId       Int?
  isSold        Boolean   @default(false)
  bids          Bid[]

  buyer User? @relation("Buyer", fields: [buyerId], references: [id])
  User  User? @relation(fields: [userId], references: [id])
}

model Bid {
  id        Int      @id @default(autoincrement())
  amount    Float
  userId    Int
  postId    Int
  createdAt DateTime @default(now())

  User User? @relation(fields: [userId], references: [id])
  Post Post  @relation(fields: [postId], references: [id])
}

model Image {
  id        Int      @id @default(autoincrement())
  path      String
  postId    Int
  createdAt DateTime @default(now())

  Post Post @relation(fields: [postId], references: [id])
}

enum categories {
  Elektronik
  Fahrzeuge
  Haushalt
  Kleider_Accessoires @map("Kleider/Accessoires")
  M_bel               @map("Möbel")
  Deko
  Sport
  Sonstiges
}
