<% const title = 'All Posts'; %>
<% if (!posts.length) { %>
    <p class="text-gray-600">No posts yet. <a href="/posts/new" class="text-blue-600 hover:underline">Create the first one</a>.</p>
<% } else { %>
    <div class="flex flex-wrap gap-4">
        <% posts.forEach(p => { %>
            <div class="flex-1 min-w-[250px] max-w-1/3 p-4 bg-white rounded-lg shadow-sm ring-1 ring-gray-200">
                <div class="flex flex-col gap-2">
                    <a href="/posts/view/<%= p.id %>" class="font-medium text-gray-900 hover:underline break-words"><%= p.title %></a>
                    <div class="text-xs text-gray-500">Created <%= new Date(p.createdAt).toLocaleString() %></div>
                    <a href="/posts/view/<%= p.id %>" class="text-sm text-blue-600 hover:underline self-start">View</a>
                </div>
            </div>
        <% }) %>
    </div>

<% } %>