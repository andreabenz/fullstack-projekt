<% const title = post.title; %>
<article>
    <div class="flex flex-col sm:flex-row-reverse justify-end items-top gap-3">
        <div class="rounded-md border-gray-400 shadow-sm sm:w-1/3 p-3">
            <p class="text-gray-700 italic block">
                <%= CATEGORY_LABELS[post.category] || post.category %>
            </p>
            <h2 class="text-2xl font-semibold text-gray-900"><%= post.title %></h2>
            <p class="mt-2 text-xs text-gray-500">
                Created: <%= new Date(post.createdAt).toLocaleString() %>
            </p>
            <% if (new Date(post.updatedAt).toLocaleString() !== new Date(post.createdAt).toLocaleString()) {%>
                <p class=" text-xs text-gray-500">
                    Last updated: <%= new Date(post.updatedAt).toLocaleString() %>
                </p>
            <% } %>
        </div>
        <div>
            <div class="swiper sm:w-5/6 w-full max-w-xl overflow-hidden">
                <div class="swiper-wrapper !h-auto">
                    <% if (post.images && post.images.length) { %>
                        <% post.images.forEach(img => { %>
                            <div class="swiper-slide flex justify-center items-center px-12">
                                <img src="<%= img.path %>" alt="Bild" class="object-cover w-full h-auto rounded-md"/>
                            </div>
                        <% }) %>
                    <% } %>
                </div>


                <div class="swiper-pagination"></div>
                <div class="swiper-button-prev"></div>
                <div class="swiper-button-next"></div>
            </div>
            <div class="sm:w-5/6 mx-auto">
                <div class="mt-2 p-3 rounded-md border-gray-400 shadow-sm">
                    <p class="text-sm font-semibold text-gray-600 mb-1 italic">
                        Beschreibung:
                    </p>
                    <p class="text-gray-800">
                        <%= post.description %>
                    </p>
                </div>
            </div>


        </div>
    </div>
</article>