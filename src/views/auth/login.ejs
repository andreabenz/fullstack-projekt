<% const title = 'Login'; %>
<h2 class="text-xl font-semibold mb-4">Login</h2>

<% if (typeof error !== 'undefined') { %>
    <div class="mb-4 p-3 bg-red-100 border border-red-400 text-red-700 rounded">
        <%= error %>
    </div>
<% } %>

<form action="/login" method="post" class="space-y-4">
    <div>
        <label class="block text-sm font-medium text-gray-700">Email</label>
        <input type="email" name="email" required
               class="flex mt-1 mb-4 text-md text-gray-800 font-normal rounded-md border-gray-400 shadow-sm w-2/3 focus:outline-none focus:ring-2 focus:ring-blue-500" />
    </div>
    <div>
        <label class="block text-sm font-medium text-gray-700">Password</label>
        <input type="password" name="password" required
               class="flex mt-1 text-md text-gray-800 font-normal rounded-md border-gray-400 shadow-sm w-2/3 focus:outline-none focus:ring-2 focus:ring-blue-500" />
    </div>
    <div class="flex items-center gap-5 pt-1.5">
        <button type="submit" class="text-md font-normal px-4 py-2 rounded md bg-blue-600 text-white shadow-sm hover:bg-blue-500 focus:ring-blue ring-offset-2 transition cursor-pointer">
            Login
        </button>
        <a href="/register" class="text-md font-normal text-gray-600 hover:underline">Register</a>
    </div>
</form>