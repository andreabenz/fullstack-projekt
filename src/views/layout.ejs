<html lang="de">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title><%= typeof title !== 'undefined' ? title : 'Fullstack Projekt' %></title>
    <link rel="stylesheet" href="/public/styles.css"/>
</head>

<body class="bg-gray-50 text-gray-900 flex flex-col min-h-screen">
<%# Header %>
<%- include('./partials/header') %>

<div class="max-w-6xl mx-auto py-8 px-4 flex space-x-6 mt-[4.25rem] items-start grow">

    <%# Sidebar %>
    <%- include('./partials/sidebar') %>

    <%# Main Content %>
    <main class="flex-1">
        <div class="bg-white shadow-sm ring-1 ring-gray-200 rounded-lg p-6" >
            <%- body %>
        </div>
    </main>

</div>

<%# Footer %>
<%- include('./partials/footer') %>

</body>
</html>